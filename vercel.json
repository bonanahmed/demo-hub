    {
      "source": "/shoe-tryon",
      "destination": "https://demo-shoe-tryon.vercel.app/shoe-tryon/"
    },
    {
      "source": "/shoe-tryon/",
      "destination": "https://demo-shoe-tryon.vercel.app/shoe-tryon/"
    },
    {
      "source": "/shoe-tryon/:path*",
      "destination": "https://demo-shoe-tryon.vercel.app/shoe-tryon/:path*"
    }
  ]
