  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/patreon-gatekeeper",
      "destination": "https://demo-patreon-gatekeeper.vercel.app/patreon-gatekeeper"
    },
    {
      "source": "/patreon-gatekeeper/:path*",
      "destination": "https://demo-patreon-gatekeeper.vercel.app/patreon-gatekeeper/:path*"
    },
    {
      "source": "/ai-agent-kopisenja",
      "destination": "https://demo-ai-agent-kopisenja.vercel.app/"
    },
    {
      "source": "/ai-agent-kopisenja/:path*",
      "destination": "https://demo-ai-agent-kopisenja.vercel.app/:path*"
